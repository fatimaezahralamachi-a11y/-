<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Plante Doctor AI — تشخيص احترافي للنباتات</title>
  <style>
    :root{
      --bg:#f2f7f4;
      --card:#ffffff;
      --primary:#15803d;
      --primary-2:#16a34a;
      --dark:#052e16;
      --accent:#dcfce7;
      --text:#0f172a;
      --muted:#64748b;
      --border:#e2e8f0;
      --warn-bg:#fef2f2;
      --warn-tx:#991b1b;
      --mid-bg:#fefce8;
      --mid-tx:#854d0e;
      --ok-bg:#dcfce7;
      --ok-tx:#166534;
    }
    *{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
    body{background:var(--bg);color:var(--text);max-width:480px;margin:0 auto;padding:14px 14px 52px}

    .header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    .brand{display:flex;align-items:center;gap:10px}
    .logo{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--primary-2),var(--dark));color:#fff;display:grid;place-items:center;font-size:1.3rem;box-shadow:0 6px 16px rgba(21,128,61,.2)}
    .brand h1{font-size:1.08rem;font-weight:800;color:var(--dark)}
    .brand p{font-size:.74rem;color:var(--muted)}
    .chip{background:var(--accent);color:var(--dark);font-size:.72rem;font-weight:800;padding:6px 11px;border-radius:999px;border:1px solid #bbf7d0}

    .hero{background:linear-gradient(145deg,var(--primary),var(--dark));color:#fff;border-radius:24px;padding:20px;margin-bottom:14px;box-shadow:0 12px 26px rgba(5,46,22,.18)}
    .hero h2{font-size:1.22rem;font-weight:800;margin-bottom:6px}
    .hero p{font-size:.82rem;opacity:.92;line-height:1.6;margin-bottom:16px}
    .actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .btn{border:none;border-radius:14px;padding:12px 14px;font-weight:800;font-size:.86rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;transition:transform .12s ease}
    .btn:active{transform:scale(.98)}
    .btn-cam{background:#fff;color:var(--dark)}
    .btn-gal{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.28)}

    .card{background:var(--card);border:1px solid var(--border);border-radius:22px;padding:16px;margin-bottom:14px;box-shadow:0 6px 18px rgba(15,23,42,.04)}
    .preview-wrap{display:none}
    .preview-wrap.show{display:block}
    .img-frame{position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:#0f172a;margin-bottom:14px}
    #imgPreview{width:100%;height:230px;object-fit:cover;display:block}
    .focus-ring{position:absolute;inset:18%;border:2px dashed rgba(255,255,255,.65);border-radius:18px;pointer-events:none}

    .report{display:none}
    .report.show{display:block}
    .status-bar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap}
    .status-pill{padding:5px 12px;border-radius:999px;font-size:.75rem;font-weight:800;background:var(--mid-bg);color:var(--mid-tx)}
    .status-pill.ok{background:var(--ok-bg);color:var(--ok-tx)}
    .status-pill.warn{background:var(--warn-bg);color:var(--warn-tx)}
    .accuracy{font-size:.75rem;font-weight:700;color:var(--muted)}

    .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
    .metric{background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:9px;text-align:center}
    .metric span{display:block;font-size:.7rem;color:var(--muted);margin-bottom:2px}
    .metric strong{font-size:.9rem;color:var(--dark)}

    .sec{border:1px solid #eef2f6;background:#f8fafc;border-radius:16px;padding:13px;margin-bottom:10px}
    .sec.highlight-plant{background:#f0fdf4;border-color:#bbf7d0}
    .sec.highlight-disease{background:#fefce8;border-color:#fef08a}
    .sec.highlight-status{background:#eff6ff;border-color:#bfdbfe}
    .sec-label{font-size:.73rem;font-weight:800;color:var(--muted);margin-bottom:5px;display:block}
    .sec-title{font-size:.96rem;font-weight:800;color:var(--dark);line-height:1.5}
    .sec-body{font-size:.85rem;line-height:1.75;color:var(--text);white-space:pre-line;font-weight:600}

    .btn-save{width:100%;margin-top:4px;background:var(--primary);color:#fff;padding:13px;border-radius:14px;border:none;font-weight:800;font-size:.88rem;cursor:pointer}
    .btn-save:disabled{background:#94a3b8;cursor:default}

    .hist-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
    .hist-head h3{font-size:.95rem;font-weight:800;color:var(--dark)}
    .hist-head span{font-size:.74rem;color:var(--muted);font-weight:700}
    .hist-item{display:flex;align-items:center;gap:10px;background:#f8fafc;border:1px solid #eef2f6;border-radius:15px;padding:9px;margin-bottom:8px;cursor:pointer}
    .hist-item img{width:50px;height:50px;border-radius:11px;object-fit:cover;flex-shrink:0}
    .hist-thumb-ph{width:50px;height:50px;border-radius:11px;background:var(--accent);display:grid;place-items:center;flex-shrink:0;font-size:1.1rem}
    .hist-item b{display:block;font-size:.84rem;color:var(--dark)}
    .hist-item small{display:block;font-size:.73rem;color:var(--muted);margin-top:2px}
    .empty{text-align:center;color:var(--muted);font-size:.8rem;padding:12px 0}
  </style>
</head>
<body>
  <header class="header">
    <div class="brand">
      <div class="logo">🌿</div>
      <div>
        <h1>Plante Doctor AI</h1>
        <p>نظام تشخيص ذكي للنباتات</p>
      </div>
    </div>
    <span class="chip">ذكاء تلقائي</span>
  </header>

  <section class="hero">
    <h2>افحص نبتتك بتقرير متكامل</h2>
    <p>التقط صورة واضحة للنبتة أو اخترها من المعرض لتحليل الحالة تلقائياً وعرض اسم النبتة، المرض، تعريفه، حالة النبتة، وخطة العلاج.</p>
    <div class="actions">
      <button class="btn btn-cam" id="btnCam">📷 تصوير</button>
      <button class="btn btn-gal" id="btnGal">🖼️ المعرض</button>
    </div>
  </section>

  <input type="file" id="inCam" accept="image/*" capture="environment" hidden />
  <input type="file" id="inGal" accept="image/*" hidden />

  <section class="card preview-wrap" id="previewWrap">
    <div class="img-frame">
      <img id="imgPreview" alt="صورة النبتة" />
      <div class="focus-ring"></div>
    </div>

    <div class="report" id="reportBox">
      <div class="status-bar">
        <span class="status-pill" id="rBadge">قيد التشخيص</span>
        <span class="accuracy" id="rAcc">دقة الفحص: -</span>
      </div>

      <div class="metrics">
        <div class="metric"><span>الخضرة</span><strong id="mGreen">0%</strong></div>
        <div class="metric"><span>الاصفرار</span><strong id="mYellow">0%</strong></div>
        <div class="metric"><span>البقع/البياض</span><strong id="mSpot">0%</strong></div>
      </div>

      <div class="sec highlight-plant">
        <span class="sec-label">اسم النبتة / العينة المحتمل</span>
        <div class="sec-title" id="rPlant">-</div>
      </div>

      <div class="sec highlight-disease">
        <span class="sec-label">اسم المرض المحتمل</span>
        <div class="sec-title" id="rDisease">-</div>
      </div>

      <div class="sec">
        <span class="sec-label">تعريف المرض والأعراض الظاهرة</span>
        <div class="sec-body" id="rDefinition">-</div>
      </div>

      <div class="sec highlight-status">
        <span class="sec-label">حالة النبتة وشدة التأثر</span>
        <div class="sec-body" id="rStatus">-</div>
      </div>

      <div class="sec">
        <span class="sec-label">الأسباب وخطة العلاج والوقاية</span>
        <div class="sec-body" id="rTreatment">-</div>
      </div>

      <button class="btn-save" id="btnSave" disabled>💾 حفظ التقرير في السجل</button>
    </div>
  </section>

  <section class="card">
    <div class="hist-head">
      <h3>سجل الفحوصات</h3>
      <span id="histCount">0 فحوصات</span>
    </div>
    <div id="histList"></div>
  </section>

  <script>
    const $ = (id) => document.getElementById(id);
    const STORAGE_KEY = "plante_doctor_pro_v1";
    let currentReport = null;
    let memoryStore = [];

    function loadHistory() {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        if (Array.isArray(parsed) && parsed.length) {
          memoryStore = parsed;
          return parsed;
        }
      } catch (e) {}
      return memoryStore;
    }

    function saveHistory(list) {
      memoryStore = list.slice(0, 10);
      try {
        const compact = memoryStore.slice(0, 4).map((item) => ({
          id: item.id,
          plant: item.plant,
          disease: item.disease,
          definition: item.definition,
          statusText: item.statusText,
          treatment: item.treatment,
          badge: item.badge,
          badgeClass: item.badgeClass,
          acc: item.acc,
          metrics: item.metrics,
          thumb: item.thumb || ""
        }));
        localStorage.setItem(STORAGE_KEY, JSON.stringify(compact));
      } catch (e) {
        try {
          const textOnly = memoryStore.slice(0, 6).map((item) => ({
            id: item.id,
            plant: item.plant,
            disease: item.disease,
            definition: item.definition,
            statusText: item.statusText,
            treatment: item.treatment,
            badge: item.badge,
            badgeClass: item.badgeClass,
            acc: item.acc,
            metrics: item.metrics,
            thumb: ""
          }));
          localStorage.setItem(STORAGE_KEY, JSON.stringify(textOnly));
        } catch (e2) {}
      }
      renderHistory();
    }

    function renderHistory() {
      const items = loadHistory();
      $("histCount").textContent = items.length + " فحوصات";
      if (!items.length) {
        $("histList").innerHTML = `<div class="empty">لا توجد فحوصات محفوظة بعد.</div>`;
        return;
      }
      $("histList").innerHTML = items.map((it) => `
        <div class="hist-item" onclick="openReport(${it.id})">
          ${it.thumb
            ? `<img src="${it.thumb}" alt="" />`
            : `<div class="hist-thumb-ph">🌿</div>`}
          <div>

